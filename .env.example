# Copy to .env and fill in. Without a key the site runs in demo mode.
ANTHROPIC_API_KEY=
# (CLAUDE_API works too, if you prefer that name)
# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low        # low | medium | high - higher = smarter but slower replies
# WEB_SEARCH=off           # turn off live web search (needs to be enabled for your org in the Claude Console)
# PORT=8787
